      "type": "text",
      "multiline": true
    },
    "image": {
      "type": "media",
      "multiple": false,
      "allowedTypes": [
        "images"
      ]
    },
    "imageCaption": {
      "type": "string"
    },
    "attributionName": {
      "type": "string"
    },
    "attributionTitle": {
      "type": "string"
    },
    "imagePosition": {
      "type": "enumeration",
      "enum": [
        "right",
        "left"
      ],
      "default": "right"
    }
  }
}
